      "sql": "WITH orders AS (\n  SELECT\n      t.order_id,\n      MIN(t.created_at) AS first_attempt_at,\n      MAX(CASE WHEN t.status = 'SUCCESS' THEN 1 ELSE 0 END) AS succeeded\n  FROM transactions AS t\n  WHERE t.status IN ('SUCCESS', 'FAILED')\n    AND ((t.created_at >= TIMESTAMP '2026-11-09 00:00:00' AND t.created_at < TIMESTAMP '2026-11-16 00:00:00'))\n  GROUP BY t.order_id\n)\nSELECT\n    'current' AS period,\n    SUM(o.succeeded) AS numerator,\n    COUNT(*) AS denominator\nFROM orders AS o\nWHERE ((o.first_attempt_at >= TIMESTAMP '2026-11-09 00:00:00' AND o.first_attempt_at < TIMESTAMP '2026-11-16 00:00:00'))\nGROUP BY 1\nORDER BY 1",
