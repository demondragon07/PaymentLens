      "sql": "SELECT\n    CASE WHEN t.created_at >= TIMESTAMP '2026-11-09 00:00:00' AND t.created_at < TIMESTAMP '2026-11-16 00:00:00' THEN 'current' WHEN t.created_at >= TIMESTAMP '2026-11-02 00:00:00' AND t.created_at < TIMESTAMP '2026-11-09 00:00:00' THEN 'previous' END AS period,\n    COALESCE(b.bank_name, 'UNKNOWN') AS bank,\n    SUM(CASE WHEN t.status = 'SUCCESS' THEN 1 ELSE 0 END) AS numerator,\n    COUNT(*) AS denominator\nFROM transactions AS t\nLEFT JOIN banks AS b ON t.bank_id = b.bank_id\nWHERE t.status IN ('SUCCESS', 'FAILED')\n  AND ((t.created_at >= TIMESTAMP '2026-11-09 00:00:00' AND t.created_at < TIMESTAMP '2026-11-16 00:00:00') OR (t.created_at >= TIMESTAMP '2026-11-02 00:00:00' AND t.created_at < TIMESTAMP '2026-11-09 00:00:00'))\nGROUP BY 1, 2\nORDER BY 1, 2",
